# Anthropic API key, used to write the consolidated digest from raw source items.
ANTHROPIC_API_KEY=

# Twilio WhatsApp sandbox credentials (console.twilio.com -> Messaging -> Try it out -> WhatsApp).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is always whatsapp:+14155238886 unless you've moved to a paid WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your WhatsApp number, e.g. whatsapp:+919876543210. Must have joined the sandbox first.
TWILIO_WHATSAPP_TO=

# Optional: NewsAPI.org key, used to track the closed-lab providers (OpenAI, Anthropic, Google,
# Meta, xAI, Mistral) whose own blogs block plain HTTP scraping. Free tier at newsapi.org.
# Sources of type "newsapi" in config/sources.yaml are skipped (not failed) if this is unset.
NEWSAPI_KEY=

# Optional: set to "true" to send a "no new releases" WhatsApp message even when nothing new
# was found. Defaults to false (stay quiet on empty days).
SEND_ON_EMPTY=false
